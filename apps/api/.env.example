# Server
PORT=4000
HOST=0.0.0.0

# Comma-separated list of allowed origins for CORS (admin + mobile dev + production)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:19006,https://duhahe-admin.vercel.app

# Admin auth
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@duhahe.rw
ADMIN_PASSWORD=admin123
ADMIN_NAME=Esperance Mukabaranga

# --- Phase 2: MongoDB (not required yet) ---
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/duhahe

# --- Phase 2: MTN Mobile Money (MTN MoMo Sandbox) ---
# MTN_MOMO_ENABLED=false
# MTN_MOMO_API_USER=
# MTN_MOMO_API_KEY=
# MTN_MOMO_SUBSCRIPTION_KEY=
# MoMo Pay: number 0799659605, code 99958
MTN_MOMO_PAYEE_PHONE=250799659605
MTN_MOMO_PAYEE_CODE=99958
# MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com

# --- Phase 2: Airtel Money ---
# AIRTEL_MONEY_ENABLED=false
# AIRTEL_BASE_URL=https://www.airtel.co.rw
# AIRTEL_CLIENT_ID=
# AIRTEL_CLIENT_SECRET=

# --- Paypack (mobile money: MTN MoMo / Airtel Money via one API) ---
# Register the webhook URL shown by GET /api/webhooks/paypack/config
PAYPACK_ENABLED=false
PAYPACK_BASE_URL=https://payments.paypack.rw/api
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
# "copy webhook secret" on the Paypack webhook card (used for x-paypack-signature)
PAYPACK_WEBHOOK_SIGN_KEY=
# MUST match the webhook Mode set on the dashboard (development | production)
PAYPACK_WEBHOOK_MODE=development
# Public HTTPS origin of this API, e.g. https://duhahe-api.onrender.com
PUBLIC_URL=

# --- Phase 2: WhatsApp Business Cloud API ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=